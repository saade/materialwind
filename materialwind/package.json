{
  "name": "materialwind-css",
  "version": "0.1.0",
  "description": "Material Design 3 color system for Tailwind CSS 4, with dynamic color.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://saade.github.io/materialwind/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saade/materialwind.git",
    "directory": "materialwind"
  },
  "bugs": {
    "url": "https://github.com/saade/materialwind/issues"
  },
  "keywords": [
    "tailwindcss",
    "tailwind-plugin",
    "material-design",
    "material-you",
    "md3",
    "dynamic-color"
  ],
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
